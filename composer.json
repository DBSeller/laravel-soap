{
    "name": "dbseller/laravel-soap",
    "description": "A SoapClient wrapper integration for Laravel",
    "keywords": [
        "laravel",
        "soap",
        "client",
        "wrapper"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Michael van de Rijt",
            "email": "me@mvdrijt.com"
        },
        {
            "name": "Gabriel Morgado",
            "email": "gabriel.morgado@dbseller.com.br"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "ext-soap": "*"
    },
    "autoload": {
        "psr-0": {
            "Artisaninweb\\SoapWrapper": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Artisaninweb\\SoapWrapper\\ServiceProvider"
            ],
            "aliases": {
                "SoapWrapper": "Artisaninweb\\SoapWrapper\\Facade"
            }
        }
    },
    "replace": {
        "artisaninweb/laravel-soap": "self.version"
    },
    "version": "0.3.0.11"
}
